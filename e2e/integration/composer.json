{
	"require": {
		"phpstan/phpstan": "^2.1.0",
		"phpstan/extension-installer": "1.4.x-dev",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpunit/phpunit": "^9.5"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../..",
			"options": {
				"symlink": false
			}
		}
	],
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
